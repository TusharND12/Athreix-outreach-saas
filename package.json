    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.20",
    "jsdom": "^27.4.0",
    "postcss": "8.5.10",
    "prettier": "^3.9.5",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
