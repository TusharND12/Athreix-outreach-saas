{
  "name": "athreix-prospect-ai",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "AI-native B2B and B2C prospect intelligence for trustworthy discovery, scoring, and outreach.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATHREIX/athreix-prospect-ai.git"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "models:generate": "prisma generate",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:smoke": "tsx scripts/firebase-smoke.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "6.19.0",
