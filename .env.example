# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=false
# Set both flags to disable every fixture fallback while retaining the local
# in-memory workspace when Firebase is not attached.
LIVE_DATA_ONLY=false
NEXT_PUBLIC_LIVE_DATA_ONLY=false

# Authentication (Auth.js)
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=
EMAIL_FROM=noreply@example.com
PASSWORD_RESET_TTL_MINUTES=30
TERMS_VERSION=2026-07-20
RESPONSIBLE_USE_VERSION=2026-07-20

# Billing (disabled unless every value below is configured)
BILLING_PROVIDER=
# Use "stripe" only after Stripe Tax is activated, or "manual" only when the
# company has an approved external tax calculation/remittance process.
BILLING_TAX_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Firebase (Firestore is the primary database)
FIREBASE_PROJECT_ID=athreix-outreach-saas
FIREBASE_STORAGE_BUCKET=athreix-outreach-saas.firebasestorage.app
# Local development only. Keep this file outside source control.
GOOGLE_APPLICATION_CREDENTIALS=.athreix/firebase-admin.json
# On managed Google runtimes, omit credentials and use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDApvZqpT77gVots6VSZzLWd-OCdV47IgM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=athreix-outreach-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=athreix-outreach-saas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=athreix-outreach-saas.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=37525009183
NEXT_PUBLIC_FIREBASE_APP_ID=1:37525009183:web:160876142d66e99e93f62a

# Managed search queue (Google Cloud Tasks -> private Cloud Run worker)
CLOUD_TASKS_QUEUE=athreix-search
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
SEARCH_TASK_TARGET_URL=
CLOUD_TASKS_MAX_ATTEMPTS=3
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=900
SEARCH_TASK_SIGNING_SECRET=
# Local-only example. Generate a unique production key with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# OpenRouter (the only LLM gateway used by Athreix)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SCORING_MODEL=openrouter/auto
OPENROUTER_OUTREACH_MODEL=openrouter/auto
OPENROUTER_RESEARCH_MODEL=openrouter/auto
OPENROUTER_SITE_NAME=Athreix
OPENROUTER_SCORING_TIMEOUT_MS=25000
OPENROUTER_OUTREACH_TIMEOUT_MS=30000
OPENROUTER_RESEARCH_TIMEOUT_MS=45000
OPENROUTER_SCORING_MAX_RETRIES=1
OPENROUTER_OUTREACH_MAX_RETRIES=1
OPENROUTER_RESEARCH_MAX_RETRIES=1
# Per worker process; raise only after checking account rate limits and latency.
OPENROUTER_SCORING_CONCURRENCY=6
OPENROUTER_RESEARCH_CONCURRENCY=4
OPENROUTER_ANALYSIS_WINDOW_SIZE=24
SEARCH_ANALYSIS_BUDGET_MS=600000

# Apify
APIFY_API_TOKEN=
APIFY_B2B_ACTOR_ID=
APIFY_B2C_ACTOR_ID=
NEXT_PUBLIC_B2B_JURISDICTION=
# Comma-separated reviewed actor IDs. Production runs reject actors outside this list.
APIFY_ALLOWED_ACTORS=
# Must match the provider terms version recorded in every current review/source approval.
APIFY_TERMS_VERSION=
# JSON array. Reviews require creator, ISO timestamps, expiry, terms/review versions, modes,
# jurisdictions, permissions and per-run memory/time/cost limits.
# [{"actorId":"owner/actor","creator":"owner","reviewedAt":"2026-07-20T00:00:00.000Z","expiresAt":"2027-07-20T00:00:00.000Z","termsVersion":"2026-01","reviewVersion":"review-v1","modes":["B2B"],"jurisdictions":["*"],"permissions":["professional_business_data"],"maxMemoryMbytes":1024,"timeoutSecs":300,"maxTotalChargeUsd":5,"approved":true}]
APIFY_ACTOR_REVIEWS_JSON=
# Exact, reviewed consumer-source references; arbitrary request text is rejected.
# Bind every source reference to the workspace(s) that own or licensed it.
# [{"reference":"partner:contract-123","audienceSource":"PERMISSIONED_PARTNER","actorId":"owner/consumer-actor","sourceOwner":"Partner Ltd","workspaceIds":["workspace_cuid"],"jurisdictions":["India"],"reviewedAt":"2026-07-20T00:00:00.000Z","expiresAt":"2027-07-20T00:00:00.000Z","termsVersion":"2026-01","approved":true}]
APIFY_B2C_SOURCES_JSON=
# Parallel company-research actors. Every actor must also be present in
# APIFY_ALLOWED_ACTORS and have a current entry in APIFY_ACTOR_REVIEWS_JSON.
# Supported keys: google_search, google_maps, website, contact, about, services,
# careers, news, company_profile, reviews, social.
# [{"key":"google_search","actorId":"owner/google-search","queryTemplate":"{{company.name}} {{company.location}}","resultLimit":8,"retries":1,"enabled":true},{"key":"website","actorId":"owner/website-crawler","input":{"startUrls":[{"url":"{{company.website}}"}],"maxCrawlPages":12},"resultLimit":12,"retries":1,"enabled":true}]
APIFY_RESEARCH_ACTORS_JSON=[]
APIFY_RESEARCH_COMPANY_CONCURRENCY=3
APIFY_RESEARCH_ACTOR_CONCURRENCY=6
APIFY_RESEARCH_CACHE_TTL_MINUTES=1440

# Operations
CRON_SECRET=local-only-cron-secret-change-before-production
ADMIN_EMAILS=
SEARCH_JOB_HEARTBEAT_INTERVAL_MS=10000
SEARCH_JOB_STALE_AFTER_MS=90000
