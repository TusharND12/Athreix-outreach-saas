{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/retention",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/internal/monitoring",
      "schedule": "*/5 * * * *"
    }
  ]
}
